<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_gravity="center"
        android:gravity="center"
        android:background="#FF2626"
        android:padding="10dp"
        android:orientation="horizontal"
        android:weightSum="12">

        <ImageView
            android:id="@+id/imgBackward"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:background="@drawable/backward"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/tvScreenTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="10"
            android:gravity="center"
            android:text="Chi tiết bài viết"
            android:textColor="#FFFFFF"
            android:textSize="20dp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/imgUserAvatar"
            android:layout_width="60dp"
            android:layout_height="60dp"
            app:srcCompat="@drawable/avatar" />

        <TextView
            android:id="@+id/txtAuthor"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="7dp"
            android:textSize="25sp"
            android:layout_gravity="center_vertical"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:text="Nguyễn Văn A">
        </TextView>
        <TextView
            android:id="@+id/txtTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="50dp"
            android:text="11 phút trước"
            android:textSize="14sp"
            android:textColor="@android:color/darker_gray" />
    </LinearLayout>
        <LinearLayout
            android:layout_width="390dp"
            android:layout_height="300dp"
            android:orientation="vertical"
            android:layout_gravity="center">
            <TextView
                android:id="@+id/txtAuthor"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:paddingLeft="5dp"
                android:gravity="center_vertical"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:text="Lỗi âm thanh ở listening">
            </TextView>
            <TextView
                android:id="@+id/txtContent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingLeft="5dp"
                android:gravity="top"
                android:textSize="15sp"
                android:textColor="@color/black"
                android:text="Mình bấm nút play hoài mà không nghe được âm thanh gì hết á. 😥
Loa máy mình vẫn ổn, coi YouTube bình thường, mấy bài trước thì vẫn nghe được. Chỉ riêng bài này bị.">
            </TextView>
        </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginTop="10dp"
        android:background="@android:color/darker_gray" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal">
        <ImageButton
            android:id="@+id/btnLike"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginLeft="50dp"
            android:layout_gravity="center_vertical"
            android:background="@color/White"
            android:scaleType="centerCrop"
            app:srcCompat="@drawable/like_icon" />

        <TextView
            android:id="@+id/txtLikeNum"
            android:layout_width="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginLeft="3dp"
            android:layout_gravity="center_vertical"
            android:layout_height="40dp"
            android:text="0"
            android:textStyle="bold"
            android:textSize="25dp"
            android:layout_toRightOf="@id/btnLike"
            android:layout_centerVertical="true"
            android:textColor="@color/black"/>
        <ImageButton
            android:id="@+id/btnComment"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginLeft="200dp"
            android:layout_gravity="center_vertical"
            android:background="@color/White"
            android:scaleType="centerCrop"
            app:srcCompat="@drawable/comment_icon" />
    </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@android:color/darker_gray" />
    <ListView
        android:id="@+id/lvComments"
        android:layout_width="380dp"
        android:layout_height="match_parent"
        android:layout_marginTop="10dp"
        android:layout_gravity="center">
    </ListView>

</LinearLayout>