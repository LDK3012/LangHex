<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:backgroundTint="@null"
    android:background="@drawable/background"
    android:gravity="center"
    tools:context=".View.LoginActivity">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="450dp"
        android:layout_gravity="center"
        android:layout_marginLeft="40dp"
        android:layout_marginRight="40dp"
        android:background="@color/white"
        app:cardCornerRadius="30dp"
        app:cardElevation="20dp">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="20dp"
            android:paddingRight="20dp"
            android:paddingLeft="20dp"
            android:layout_gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imageView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/logo_main" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:orientation="vertical">

                <EditText
                    android:id="@+id/edtStudentCode"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:layout_gravity="center"
                    android:enabled="false"
                    android:inputType="text"
                    android:textSize="11dp"
                    android:hint="Student ID"
                    android:textColorHint="#898989"
                    android:paddingLeft="10dp"
                    android:background="@drawable/gray_border"
                    />

                <EditText
                    android:enabled="false"
                    android:id="@+id/edtPassword"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/gray_border"
                    android:hint="Date of Birth"
                    android:inputType="textPassword"
                    android:paddingLeft="10dp"
                    android:textColorHint="#898989"
                    android:textSize="11dp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnLogin"
                    android:layout_width="match_parent"
                    android:enabled="false"
                    android:layout_height="45dp"
                    android:layout_marginTop="15dp"
                    android:text="Login"
                    android:textSize="12dp"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:background="@drawable/red_border"
                    >
                </androidx.appcompat.widget.AppCompatButton>

                <TextView
                    android:id="@+id/textView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="15dp"
                    android:text="Or"
                    android:textColor="#898989"
                    android:textSize="15dp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnMicrosoft"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:layout_marginTop="15dp"
                    android:background="@drawable/gray_border"
                    android:drawablePadding="10dp"
                    android:drawableStart="@drawable/microsoft_logo_1"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:text="Login with Microsoft 365"
                    android:textColor="@color/black"
                    android:textSize="10dp">

                </androidx.appcompat.widget.AppCompatButton>

            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>


</LinearLayout>