<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".View.InternalSpeakingTopic">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F13F3F"
        android:padding="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/btnClose"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="#000000" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Introducing yourself\nand others"
            android:textAlignment="center"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp" />
    </LinearLayout>

    <!-- ScrollView chứa nội dung custom -->
    <ScrollView
        android:id="@+id/scrollViewContent"
        android:layout_below="@id/header"
        android:layout_above="@+id/micArea"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/questionContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
             />

        </LinearLayout>
    </ScrollView>

    <!-- Mic -->
    <LinearLayout
        android:id="@+id/micArea"
        android:layout_alignParentBottom="true"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:background="#F32F2F"
        android:gravity="center">

        <ImageButton
            android:id="@+id/btnSpeakingMicro"
            android:layout_width="48dp"
            android:layout_height="65dp"
            android:src="@drawable/microphone"
            android:tint="@color/white"
            android:background="@android:color/transparent"
            />
    </LinearLayout>

</RelativeLayout>
