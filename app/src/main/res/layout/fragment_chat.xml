<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".View.ChatFragment">

    <!-- Main layout -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:background="#FF4F52"
            android:elevation="2dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:text="ChatEngHex"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="25sp"
                    android:textColor="@color/white" />

                <TextView
                    android:id="@+id/selectedModelText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Pro Mode"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:padding="8dp"
                    android:drawableEnd="@drawable/arrow_drop_down"
                    android:drawablePadding="4dp"
                    android:background="@drawable/sample_question_item_background" />

            </LinearLayout>


        </LinearLayout>

        <!-- Chat container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="670dp"
            android:orientation="vertical"
            android:background="@android:color/white"
            android:layout_marginBottom="12dp"
            android:padding="8dp"
            android:clipToPadding="false"
            android:elevation="2dp"
            android:id="@+id/chatContainer"
            android:backgroundTint="@android:color/white">

            <!-- RecyclerView for messages -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerChat"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:clipToPadding="false" />

            <!-- Message input -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="8dp">

                <EditText
                    android:id="@+id/edtMessage"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="45dp"
                    android:layout_marginBottom="5dp"
                    android:hint="Ask anything"
                    android:background="@drawable/edittext_background"
                    android:padding="10dp"
                    android:textSize="15sp"
                    android:inputType="textMultiLine"
                    android:maxLines="4" />

                <ImageButton
                    android:id="@+id/btnSend"
                    android:layout_width="45dp"
                    android:layout_height="50dp"
                    android:layout_marginBottom="5dp"
                    android:src="@android:drawable/ic_menu_send"
                    android:background="@android:color/transparent"
                    android:contentDescription="Send"
                    android:layout_marginStart="8dp"
                    android:visibility="visible" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Sample Questions Container -->

    <TextView
        android:id="@+id/tvIntroduce"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="250dp"
        android:textColor="@color/black"
        android:textSize="30sp"
        android:textStyle="bold"
        android:layout_gravity="center_horizontal"
        android:text="How can I help you?" />

    <LinearLayout
        android:id="@+id/sampleQuestionsContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:orientation="vertical"
        android:layout_gravity="center"
        android:padding="12dp"
        android:elevation="3dp"
        android:visibility="visible">



        <TextView
            android:id="@+id/sampleQuestion1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Where am I? And who are you?"
            android:textSize="16sp"
            android:textColor="#333333"
            android:padding="8dp"
            android:background="@drawable/sample_question_item_background"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/sampleQuestion2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="How to improve speaking skills?"
            android:textSize="16sp"
            android:textColor="#333333"
            android:padding="8dp"
            android:background="@drawable/sample_question_item_background"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/sampleQuestion3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Examples of interesting English grammar?"
            android:textSize="16sp"
            android:textColor="#333333"
            android:padding="8dp"
            android:background="@drawable/sample_question_item_background" />
    </LinearLayout>

</FrameLayout>
